---
const articles = [
  {
    category: "ENERGY MARKETS",
    title: "Stochastic Electricity Market Risk",
    description:
      "Notes on electricity price dynamics, forecast evaluation and the interpretation of risk measures across European bidding zones.",
    link: "https://substack.com/@footnoteenergy",
  },
  {
    category: "CLIMATE FINANCE",
    title: "Climate Risk and Financial Regulation",
    description:
      "Exploring how climate-related financial risks connect with established risk-management frameworks and regulatory requirements.",
    link: "https://substack.com/@footnoteenergy",
  },
  {
    category: "SUSTAINABLE FINANCE",
    title: "Measuring Sustainability in Everyday Decisions",
    description:
      "A developing editorial direction on energy consumption, household choices and the practical use of sustainability indicators.",
    link: "https://substack.com/@footnoteenergy",
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Articles | Soha Sami</title>
    <meta name="description" content="Writing by Soha Sami on energy markets, climate risk and sustainable finance." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet" />
    <style>
      :root{--paper:#f7f7f0;--green:#234b3b;--ink:#202b25;--muted:#657169;--line:#dce1d7}
      *{box-sizing:border-box}
      body{margin:0;background:var(--paper);color:var(--ink);font-family:"DM Sans",sans-serif;line-height:1.7}
      .wrap{width:min(1000px,calc(100% - 40px));margin:auto}
      header{padding:25px 0;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:20px;align-items:center}
      a{color:var(--green);text-decoration:none}
      .brand{font-weight:700;font-size:1.1rem}
      nav{display:flex;gap:20px;flex-wrap:wrap;font-size:.88rem}
      .hero{padding:80px 0 45px}
      .eyebrow{font-size:.75rem;font-weight:700;letter-spacing:.14em;color:var(--green);text-transform:uppercase}
      h1,h2{font-family:"Playfair Display",Georgia,serif;font-weight:500;line-height:1.2}
      h1{font-size:clamp(2.7rem,6vw,4.5rem);letter-spacing:-.04em;margin:15px 0}
      .lead{max-width:680px;color:var(--muted);font-size:1.05rem}
      article{padding:30px 0;border-top:1px solid var(--line);display:grid;grid-template-columns:180px 1fr;gap:30px}
      .category{font-size:.75rem;font-weight:700;letter-spacing:.1em;color:var(--green)}
      h2{font-size:1.7rem;margin:0 0 10px}
      article p{color:var(--muted);margin:0 0 15px}
      .link{font-size:.88rem;font-weight:700}
      footer{margin-top:50px;padding:25px 0;border-top:1px solid var(--line);font-size:.8rem;color:var(--muted)}
      @media(max-width:650px){header{align-items:flex-start;flex-direction:column}article{grid-template-columns:1fr;gap:8px}.hero{padding-top:55px}}
    </style>
  </head>
  <body>
    <div class="wrap">
      <header>
        <a class="brand" href="/">Soha Sami.</a>
        <nav aria-label="Main navigation">
          <a href="/">Home</a><a href="/research">Research</a><a href="/projects">Projects</a><a href="/articles">Articles</a><a href="/resources">Resources</a><a href="/about">About</a>
        </nav>
      </header>
      <main>
        <section class="hero">
          <div class="eyebrow">Writing and commentary</div>
          <h1>Ideas, explained with evidence.</h1>
          <p class="lead">Articles on energy markets, quantitative risk, climate finance and sustainability. Published essays are linked through Substack.</p>
        </section>
        {articles.map((article) => (
          <article>
            <div class="category">{article.category}</div>
            <div>
              <h2>{article.title}</h2>
              <p>{article.description}</p>
              <a class="link" href={article.link} target="_blank" rel="noreferrer">Visit Footnote Energy ↗</a>
            </div>
          </article>
        ))}
      </main>
      <footer>© {new Date().getFullYear()} Soha Sami · <a href="/">Home</a></footer>
    </div>
  </body>
</html>
