---
import BaseLayout from "../layouts/BaseLayout.astro";
const data = {
  research: ["Research", "Questions, methods and current work."],
  projects: ["Projects", "Code, data and reproducible research."],
  articles: ["Articles", "Writing on energy, markets and climate finance."],
  resources: ["Resources", "Selected tools, references and research material."],
  about: ["About", "Economics, mathematics and quantitative energy research."]
};
const [title, subtitle] = data["articles"];
---
<BaseLayout title={title + " | Soha Sami"}><section class="inner-hero shell" data-reveal><p class="eyebrow">{title}</p><h1>{subtitle}</h1></section><section class="section shell"><div class="research-grid"><article class="research-card featured" data-reveal><div class="card-top"><span>01</span><span>SELECTED</span></div><div><p class="card-kicker">{title}</p><h3>{subtitle}</h3><p>More detailed material will be added here as the research portfolio develops.</p></div><a href="/website/">Back to home ↗</a></article></div></section></BaseLayout>
