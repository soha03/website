---
const research = [
  {
    category: "ENERGY MARKETS",
    title: "Stochastic Electricity Market Risk",
    description:
      "Analysing electricity price dynamics across European bidding zones using statistical models, forecasting benchmarks and quantitative risk measures.",
    methods: "Time-series modelling · Forecast evaluation · VaR · Expected Shortfall",
    status: "Research in progress",
  },
  {
    category: "CLIMATE FINANCE",
    title: "Climate Risk and Financial Stability",
    description:
      "Investigating how climate-related risks enter financial risk assessment, with attention to quantitative methods and regulatory frameworks.",
    methods: "Risk measurement · Scenario analysis · Financial regulation",
    status: "Research interest",
  },
  {
    category: "SUSTAINABLE FINANCE",
    title: "ESG and Everyday Economic Decisions",
    description:
      "Exploring how household energy consumption, transport and purchasing decisions can be measured using transparent sustainability indicators.",
    methods: "Data analysis · Sustainability metrics · Behavioural economics",
    status: "Research interest",
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Research | Soha Sami</title>
    <meta name="description" content="Research interests and quantitative work by Soha Sami in energy markets, climate risk and sustainable finance." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet" />
    <style>
      :root{--paper:#f7f7f0;--green:#234b3b;--light:#e5ebdf;--ink:#202b25;--muted:#657169;--line:#dce1d7;--white:#fffefa}
      *{box-sizing:border-box}
      body{margin:0;background:var(--paper);color:var(--ink);font-family:"DM Sans",sans-serif;line-height:1.7}
      .wrap{width:min(1000px,calc(100% - 40px));margin:auto}
      header{padding:25px 0;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:20px;align-items:center}
      a{color:var(--green);text-decoration:none}
      .brand{font-weight:700;font-size:1.1rem}
      nav{display:flex;gap:20px;flex-wrap:wrap;font-size:.88rem}
      .hero{padding:80px 0 55px}
      .eyebrow{font-size:.75rem;font-weight:700;letter-spacing:.14em;color:var(--green);text-transform:uppercase}
      h1,h2,h3{font-family:"Playfair Display",Georgia,serif;font-weight:500;line-height:1.2}
      h1{font-size:clamp(2.7rem,6vw,4.5rem);letter-spacing:-.04em;margin:15px 0}
      .lead{max-width:680px;color:var(--muted);font-size:1.05rem}
      .item{padding:32px 0;border-top:1px solid var(--line);display:grid;grid-template-columns:190px 1fr;gap:35px}
      .category{font-size:.75rem;color:var(--green);font-weight:700;letter-spacing:.1em}
      h2{font-size:1.8rem;margin:0 0 12px}
      .description{color:var(--muted);margin:0 0 18px}
      .methods{font-size:.85rem}
      .status{display:inline-block;margin-top:14px;padding:5px 10px;background:var(--light);color:var(--green);font-size:.75rem}
      footer{margin-top:50px;padding:25px 0;border-top:1px solid var(--line);font-size:.8rem;color:var(--muted)}
      @media(max-width:650px){header{align-items:flex-start;flex-direction:column}.item{grid-template-columns:1fr;gap:10px}.hero{padding-top:55px}}
    </style>
  </head>
  <body>
    <div class="wrap">
      <header>
        <a class="brand" href="/">Soha Sami.</a>
        <nav aria-label="Main navigation">
          <a href="/">Home</a><a href="/research">Research</a><a href="/projects">Projects</a><a href="/articles">Articles</a><a href="/resources">Resources</a><a href="/about">About</a>
        </nav>
      </header>
      <main>
        <section class="hero">
          <div class="eyebrow">Research agenda</div>
          <h1>Questions, methods and evidence.</h1>
          <p class="lead">My research focuses on quantitative energy analysis, climate-related financial risk and sustainable finance. Each project aims to make its data, assumptions and methods transparent.</p>
        </section>
        {research.map((item) => (
          <article class="item">
            <div class="category">{item.category}</div>
            <div>
              <h2>{item.title}</h2>
              <p class="description">{item.description}</p>
              <div class="methods"><strong>Methods and themes:</strong> {item.methods}</div>
              <span class="status">{item.status}</span>
            </div>
          </article>
        ))}
      </main>
      <footer>© {new Date().getFullYear()} Soha Sami · <a href="/">Home</a></footer>
    </div>
  </body>
</html>
