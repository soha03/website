---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="About | Soha Sami"
  description="About Soha Sami, working across energy markets, quantitative finance and climate risk."
  active="about"
>

  <main class="about-page">

    <!-- INTRO -->
    <section class="about-hero shell">

      <div class="about-intro">
        <p class="eyebrow">ABOUT</p>

        <h1>Soha Sami</h1>

        <p class="about-lead">
          Energy markets · Quantitative finance · Climate risk
        </p>

        <div class="about-copy">
          <p>
            I’m Soha, a graduate student working across energy markets,
            quantitative finance and climate risk.
          </p>

          <p>
            My academic background combines Economics and Mathematics with
            graduate training in energy markets, financial mathematics,
            quantitative methods and climate-related finance.
          </p>

          <p>
            I am particularly interested in how uncertainty, market design
            and climate-related change affect energy systems and financial
            risk.
          </p>
        </div>
      </div>

      <div class="about-photo">
        <img
          src="../images/soha-profile.png"
          alt="Soha Sami"
        />
      </div>

    </section>


    <!-- EDUCATION -->
    <section class="about-section shell">

      <div class="section-heading">
        <p class="eyebrow">EDUCATION</p>
        <h2>Academic background</h2>
      </div>

      <div class="education-grid">

        <article class="education-card">

          <p class="education-location">
            New Delhi · India
          </p>

          <h3>University of Delhi</h3>

          <p class="degree">
            BA Economics &amp; Mathematics · 2021–2025
          </p>

          <p>
            Foundation in economics, mathematics, statistics and
            quantitative analysis.
          </p>

        </article>


        <article class="education-card">

          <p class="education-location">
            Bologna · Italy
          </p>

          <h3>Università di Bologna</h3>

          <p class="degree">
            MSc Greening Energy Market and Finance
          </p>

          <p>
            Focus on European energy markets and the economic and financial
            questions surrounding the energy transition.
          </p>

        </article>


        <article class="education-card">

          <p class="education-location">
            Munich · Germany
          </p>

          <h3>LMU Munich</h3>

          <p class="degree">
            MSc Financial and Actuarial Mathematics
          </p>

          <p>
            Training in financial mathematics, stochastic modelling,
            quantitative risk management and numerical methods.
          </p>

        </article>


        <article class="education-card current">

          <p class="education-location">
            Paris · France
          </p>

          <h3>Université Paris Dauphine-PSL</h3>

          <p class="degree">
            MSc Economics and Finance
          </p>

          <p>
            Current studies include Climate &amp; Business, connecting
            climate-related questions with economics, business and finance.
          </p>

        </article>

      </div>

    </section>


    <!-- SKILLS -->
    <section class="skills-section">

      <div class="shell">

        <div class="section-heading">
          <p class="eyebrow">SKILLS &amp; METHODS</p>
          <h2>What I have built through my studies</h2>
        </div>


        <div class="skills-grid">

          <article class="skill-card">
            <h3>Energy market analysis</h3>
            <p>
              Electricity markets, market design, power prices,
              renewable generation, flexibility and uncertainty.
            </p>
          </article>


          <article class="skill-card">
            <h3>Quantitative finance</h3>
            <p>
              Financial mathematics, quantitative risk management,
              stochastic models and risk-based analysis.
            </p>
          </article>


          <article class="skill-card">
            <h3>Stochastic modelling</h3>
            <p>
              Modelling uncertainty in financial and energy-related
              systems using probabilistic and stochastic methods.
            </p>
          </article>


          <article class="skill-card">
            <h3>Climate risk</h3>
            <p>
              Understanding physical and transition risks and their
              implications for markets, firms and finance.
            </p>
          </article>


          <article class="skill-card">
            <h3>Numerical methods</h3>
            <p>
              Numerical techniques for solving quantitative problems,
              supported by computational and mathematical methods.
            </p>
          </article>


          <article class="skill-card">
            <h3>Python &amp; data analysis</h3>
            <p>
              Using Python, statistics and data analysis to investigate
              financial, energy and climate-related questions.
            </p>
          </article>


          <article class="skill-card">
            <h3>Research</h3>
            <p>
              Translating economic and quantitative questions into
              structured research problems and analytical frameworks.
            </p>
          </article>


          <article class="skill-card">
            <h3>Technical communication</h3>
            <p>
              Communicating quantitative research clearly through
              structured analysis, writing and visual presentation.
            </p>
          </article>

        </div>

      </div>

    </section>


    <!-- RESEARCH -->
    <section class="research-section shell">

      <div class="research-grid">

        <div>
          <p class="eyebrow">RESEARCH INTERESTS</p>

          <h2>
            Questions around energy,
            finance and climate.
          </h2>
        </div>

        <div class="research-copy">

          <p>
            My interests centre on electricity markets, energy transition,
            climate risk and quantitative approaches to uncertainty.
          </p>

          <p>
            I am particularly interested in European power markets,
            renewable generation, flexibility, market risk and the
            financial implications of climate-related change.
          </p>

        </div>

      </div>

    </section>

  </main>

</BaseLayout>


<style>
  .about-page {
    background: var(--paper);
  }

  /* HERO */

  .about-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
    gap: 5rem;
    align-items: center;
    padding-top: 6rem;
    padding-bottom: 6rem;
  }

  .about-intro {
    max-width: 700px;
  }

  .about-intro h1 {
    margin: 0.4rem 0 0.65rem;
    color: var(--green-950);
  }

  .about-lead {
    margin: 0 0 2rem;
    color: var(--green-600);
    font-size: 1.1rem;
    font-weight: 600;
  }

  .about-copy {
    max-width: 660px;
  }

  .about-copy p {
    margin: 0 0 1.15rem;
    color: var(--ink);
    line-height: 1.8;
  }

  .about-copy p:last-child {
    margin-bottom: 0;
  }


  /* PHOTO */

  .about-photo {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .about-photo img {
    display: block;
    width: min(350px, 100%);
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center;
    border-radius: 50%;
    border: 9px solid var(--paper-2);
    outline: 2px solid var(--green-800);
    box-shadow: 0 18px 40px rgba(6, 37, 27, 0.14);
  }


  /* SHARED SECTION */

  .about-section {
    padding-top: 5.5rem;
    padding-bottom: 5.5rem;
  }

  .section-heading {
    max-width: 700px;
    margin-bottom: 2.5rem;
  }

  .section-heading h2 {
    margin: 0.4rem 0 0;
    color: var(--green-950);
  }


  /* EDUCATION */

  .education-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .education-card {
    padding: 2rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 22px;
    box-shadow: 0 8px 25px rgba(6, 37, 27, 0.045);
  }

  .education-card.current {
    background: var(--green-900);
    border-color: var(--green-900);
  }

  .education-location {
    margin: 0 0 0.8rem;
    color: var(--green-600);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .education-card.current .education-location {
    color: var(--lime);
  }

  .education-card h3 {
    margin: 0 0 0.65rem;
    color: var(--green-950);
  }

  .education-card.current h3 {
    color: var(--white);
  }

  .education-card .degree {
    margin: 0 0 1.15rem;
    color: var(--green-800);
    font-weight: 700;
    line-height: 1.5;
  }

  .education-card.current .degree {
    color: var(--lime);
  }

  .education-card > p:last-child {
    margin: 0;
    color: var(--muted);
    line-height: 1.75;
  }

  .education-card.current > p:last-child {
    color: rgba(251, 252, 247, 0.82);
  }


  /* SKILLS */

  .skills-section {
    padding: 6rem 0;
    background: var(--paper-2);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .skill-card {
    min-height: 190px;
    padding: 1.7rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 20px;
  }

  .skill-card h3 {
    margin: 0 0 0.8rem;
    color: var(--green-900);
  }

  .skill-card p {
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
  }


  /* RESEARCH */

  .research-section {
    padding-top: 6rem;
    padding-bottom: 6.5rem;
  }

  .research-grid {
    display: grid;
    grid-template-columns: minmax(280px, 0.8fr) minmax(0, 1.2fr);
    gap: 5rem;
    align-items: start;
  }

  .research-grid h2 {
    margin: 0.45rem 0 0;
    color: var(--green-950);
  }

  .research-copy {
    max-width: 680px;
  }

  .research-copy p {
    margin: 0 0 1.25rem;
    color: var(--muted);
    line-height: 1.8;
  }

  .research-copy p:last-child {
    margin-bottom: 0;
  }


  /* MOBILE */

  @media (max-width: 1000px) {
    .skills-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 800px) {

    .about-hero,
    .research-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .about-hero {
      padding-top: 4.5rem;
      padding-bottom: 4.5rem;
    }

    .education-grid,
    .skills-grid {
      grid-template-columns: 1fr;
    }

    .about-photo {
      order: -1;
    }

    .about-photo img {
      width: 260px;
    }
  }
</style>
