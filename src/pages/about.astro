```
---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="About Me | Soha Sami"
  description="About Soha Sami, her academic background, skills and research interests across economics, finance, energy markets and climate risk."
  active="about"
>

  <main class="about-page">

    <!-- HERO -->
    <section class="about-hero">
      <div class="about-shell">

        <p class="about-kicker">ABOUT ME</p>

        <div class="about-hero-grid">

          <div class="about-hero-copy">

            <h1>
              I study how uncertainty and the energy transition shape
              markets, financial decisions and risk.
            </h1>

            <p>
              My background is in economics and mathematics and has
              expanded through finance, energy economics, quantitative
              finance, computational methods and climate-related research.
            </p>

            <p>
              My studies have taken me from New Delhi to Bologna, Munich
              and Paris, giving me experience across economics, finance,
              energy markets and quantitative modelling.
            </p>

          </div>


          <div class="about-photo-frame">
            <img
              src="/website/images/soha-profile.png"
              alt="Soha Sami"
            />
          </div>

        </div>

      </div>
    </section>


    <!-- EDUCATION -->
    <section class="about-section">

      <div class="about-shell">

        <div class="section-intro">
          <p class="about-kicker">EDUCATION</p>
          <h2>A multidisciplinary academic path.</h2>
        </div>


        <div class="university-grid">

          <!-- DELHI -->
          <a href="https://www.du.ac.in/"

            target="_blank"
            rel="noreferrer"
            class="university-card"
          >

            <div class="university-image university-delhi">

              <img src="/website/images/DUcolourLogo.png" alt="University of Delhi" />

            </div>

            <div class="university-content">
              <span>NEW DELHI · INDIA ↗</span>

              <h3>University of Delhi</h3>

              <strong>BA Economics &amp; Mathematics</strong>

              <small>2021–2025</small>

              <p>
                Economics, mathematics, statistics and quantitative analysis.
              </p>
            </div>

          </a>


          <!-- BOLOGNA -->
          <a href="https://corsi.unibo.it/2cycle/GreeningEnergyMarketFinance/programme-aims"

            target="_blank"
            rel="noreferrer"
            class="university-card"
          >

            <div class="university-image university-bologna">

              <img src="/website/images/bol logo.png" alt="Università di Bologna" />

            </div>

            <div class="university-content">
              <span>BOLOGNA · ITALY ↗</span>

              <h3>Università di Bologna</h3>

              <strong>MSc Greening Energy Market and Finance</strong>

              <small>Finance · Economics · Energy &amp; Climate</small>

              <p>
                Finance and economics applied to energy and climate,
                including energy markets, financial analysis and risk.
              </p>
            </div>

          </a>


          <!-- LMU -->
          <a href="https://www.fm.math.lmu.de/en/study-programs/master-financial-and-insurance-mathematics/"

            target="_blank"
            rel="noreferrer"
            class="university-card"
          >

            <div class="university-image university-lmu">

              <img src="/website/images/Logo_LMU.svg" alt="LMU Munich" />

            </div>

            <div class="university-content">
              <span>MUNICH · GERMANY ↗</span>

              <h3>LMU Munich</h3>

              <strong>MSc Financial and Insurance Mathematics</strong>

              <small>
                Computational Finance · Fixed Income · QRM · Numerical Methods
              </small>

              <p>
                Financial mathematics, stochastic modelling, quantitative
                risk management, computational finance and numerical methods.
              </p>
            </div>

          </a>


          <!-- DAUPHINE -->
          <a href="https://dauphine.psl.eu/en/training/masters-degrees/economics-and-finance"

            target="_blank"
            rel="noreferrer"
            class="university-card university-featured"
          >

            <div class="university-image university-paris">

              <img src="/website/images/LogoDauphine_RVB-Bleu.webp" alt="Université Paris Dauphine-PSL" />

            </div>

            <div class="university-content">
              <span>PARIS · FRANCE ↗</span>

              <h3>Université Paris Dauphine-PSL</h3>

              <strong>MSc Economics and Finance</strong>

              <small>
                Energy Economics · Empirical Markets · Project Finance
              </small>

              <p>
                Economics and finance with work in empirical modelling of
                electricity and gas markets, project finance and climate
                and business topics.
              </p>
            </div>

          </a>

        </div>

      </div>
    </section>


    <!-- SKILLS -->
    <section class="about-section skills-section">

      <div class="about-shell">

        <div class="section-intro">
          <p class="about-kicker">SKILLS &amp; METHODS</p>
          <h2>What I have learned to work with.</h2>
        </div>


        <div class="skills-grid">

          <!-- ENERGY -->
          <article class="skill-card">

            <div class="skill-drawing">
              <svg viewBox="0 0 100 100" aria-hidden="true">
                <path
                  d="M15 72 L35 48 L50 62 L70 28 L88 42"
                  fill="none"
                  stroke="#10553d"
                  stroke-width="5"
                />
                <circle cx="15" cy="72" r="5" fill="#c7f36b"/>
                <circle cx="35" cy="48" r="5" fill="#c7f36b"/>
                <circle cx="50" cy="62" r="5" fill="#c7f36b"/>
                <circle cx="70" cy="28" r="5" fill="#c7f36b"/>
                <circle cx="88" cy="42" r="5" fill="#c7f36b"/>
              </svg>
            </div>

            <h3>Energy markets</h3>

            <p>
              Electricity and gas markets, market design, power prices,
              renewable generation and flexibility.
            </p>

          </article>


          <!-- QUANT -->
          <article class="skill-card">

            <div class="skill-drawing">
              <svg viewBox="0 0 100 100" aria-hidden="true">
                <path
                  d="M15 80
                     C25 55, 25 55, 38 65
                     C51 75, 52 30, 65 42
                     C78 54, 75 22, 88 15"
                  fill="none"
                  stroke="#10553d"
                  stroke-width="5"
                />
                <path
                  d="M15 80 H88"
                  stroke="#3f8b68"
                  stroke-width="2"
                />
                <path
                  d="M15 80 V15"
                  stroke="#3f8b68"
                  stroke-width="2"
                />
              </svg>
            </div>

            <h3>Quantitative finance</h3>

            <p>
              Stochastic modelling, computational finance, fixed income,
              quantitative risk management and numerical methods.
            </p>

          </article>


          <!-- FINANCE -->
          <article class="skill-card">

            <div class="skill-drawing">
              <svg viewBox="0 0 100 100" aria-hidden="true">
                <rect
                  x="18"
                  y="28"
                  width="64"
                  height="46"
                  rx="4"
                  fill="none"
                  stroke="#10553d"
                  stroke-width="5"
                />
                <path
                  d="M30 45 H70
                     M30 58 H55"
                  stroke="#3f8b68"
                  stroke-width="4"
                />
                <circle
                  cx="67"
                  cy="58"
                  r="7"
                  fill="#c7f36b"
                />
              </svg>
            </div>

            <h3>Finance</h3>

            <p>
              Financial markets, project finance, asset management,
              fixed income and green finance.
            </p>

          </article>


          <!-- ECONOMICS -->
          <article class="skill-card">

            <div class="skill-drawing">
              <svg viewBox="0 0 100 100" aria-hidden="true">
                <path
                  d="M20 78 H82"
                  stroke="#10553d"
                  stroke-width="5"
                />
                <path
                  d="M25 70 L25 42
                     M42 70 L42 32
                     M59 70 L59 52
                     M76 70 L76 22"
                  stroke="#3f8b68"
                  stroke-width="9"
                />
                <circle
                  cx="76"
                  cy="22"
                  r="7"
                  fill="#c7f36b"
                />
              </svg>
            </div>

            <h3>Economics &amp; empirical analysis</h3>

            <p>
              Energy economics, econometrics, empirical modelling,
              statistics and market analysis.
            </p>

          </article>


          <!-- CLIMATE -->
          <article class="skill-card">

            <div class="skill-drawing">
              <svg viewBox="0 0 100 100" aria-hidden="true">
                <path
                  d="M50 80
                     C30 63, 22 45, 35 30
                     C45 18, 61 23, 65 38
                     C82 39, 85 59, 73 68
                     C65 75, 58 77, 50 80 Z"
                  fill="none"
                  stroke="#10553d"
                  stroke-width="5"
                />
                <path
                  d="M50 77 V42
                     M50 57 L35 47
                     M50 62 L67 49"
                  stroke="#3f8b68"
                  stroke-width="4"
                />
                <circle
                  cx="69"
                  cy="30"
                  r="9"
                  fill="#c7f36b"
                />
              </svg>
            </div>

            <h3>Climate &amp; risk</h3>

            <p>
              Climate risk, transition risk, physical risk, climate
              economics and risk assessment.
            </p>

          </article>


          <!-- PROGRAMMING -->
          <article class="skill-card">

            <div class="skill-drawing">
              <svg viewBox="0 0 100 100" aria-hidden="true">
                <path
                  d="M35 30 L15 50 L35 70"
                  fill="none"
                  stroke="#10553d"
                  stroke-width="6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
                <path
                  d="M65 30 L85 50 L65 70"
                  fill="none"
                  stroke="#10553d"
                  stroke-width="6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
                <path
                  d="M55 20 L45 80"
                  stroke="#c7f36b"
                  stroke-width="6"
                  stroke-linecap="round"
                />
              </svg>
            </div>

            <h3>Programming &amp; research</h3>

            <p>
              Python, Java, data analysis, computational modelling,
              research methods and LaTeX.
            </p>

          </article>

        </div>

      </div>
    </section>


    <!-- RESEARCH -->
    <section class="research-section">

      <div class="about-shell">

        <div class="research-grid">

          <div>
            <p class="about-kicker research-kicker">RESEARCH</p>

            <h2>
              Markets, finance and the
              uncertainty behind them.
            </h2>
          </div>

          <div class="research-copy">

            <p>
              My work focuses on questions where energy markets, financial
              decisions and uncertainty meet.
            </p>

            <p>
              I am particularly interested in electricity markets,
              renewable generation, market design, climate risk,
              financial risk and quantitative approaches to understanding
              changing energy systems.
            </p>

          </div>

        </div>

      </div>

    </section>

  </main>


  <style>

    .about-page {
      width: 100%;
      overflow: hidden;
      background: var(--paper);
      color: var(--ink);
    }

    .about-shell {
      width: min(1320px, calc(100% - 6rem));
      margin: 0 auto;
    }


    /* HERO */

    .about-hero {
      padding: 6.5rem 0 7rem;
    }

    .about-kicker {
      margin: 0 0 1.4rem;
      color: var(--green-800);
      font-size: .72rem;
      line-height: 1;
      letter-spacing: .2em;
      font-weight: 700;
    }

    .about-hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(300px, .65fr);
      align-items: center;
      gap: 6rem;
    }

    .about-hero-copy h1 {
      max-width: 850px;
      margin: 0;
      font-size: clamp(3.2rem, 5.4vw, 5.5rem);
      line-height: 1.01;
      letter-spacing: -.055em;
      font-weight: 600;
    }

    .about-hero-copy > p {
      max-width: 700px;
      margin: 2rem 0 0;
      font-size: 1.08rem;
      line-height: 1.75;
      color: var(--muted);
    }

    .about-photo-frame {
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .about-photo-frame img {
      width: min(360px, 100%);
      aspect-ratio: 1;
      object-fit: cover;
      border-radius: 50%;
      padding: 8px;
      border: 2px solid var(--green-800);
      background: var(--paper);
      box-shadow: 0 24px 60px rgba(6,37,27,.12);
    }


    /* SECTIONS */

    .about-section {
      padding: 7rem 0;
      border-top: 1px solid var(--line);
    }

    .section-intro {
      max-width: 800px;
      margin-bottom: 3rem;
    }

    .section-intro h2 {
      margin: 0;
      font-size: clamp(2.2rem, 3.5vw, 3.5rem);
      line-height: 1.05;
      letter-spacing: -.045em;
      font-weight: 600;
    }


    /* UNIVERSITIES */

    .university-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.4rem;
    }

    .university-card {
      display: grid;
      grid-template-columns: .9fr 1.1fr;
      min-height: 330px;
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: 24px;
      background: var(--white);
      color: var(--ink);
      text-decoration: none;
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .university-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 18px 45px rgba(6,37,27,.1);
    }

    .university-image {
      min-height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .university-image svg {
      width: 100%;
      height: 100%;
      min-height: 330px;
      display: block;
    }

    .university-image img {
      width: 140px;
      height: 80px;
      object-fit: contain;
      display: block;
      margin: 0 auto;
    }

    .university-content {
      padding: 2.2rem;
      display: flex;
      flex-direction: column;
    }

    .university-content > span {
      color: var(--green-800);
      font-size: .7rem;
      letter-spacing: .15em;
      font-weight: 700;
    }

    .university-content h3 {
      margin: 2.2rem 0 .9rem;
      font-size: 1.45rem;
      line-height: 1.15;
      letter-spacing: -.03em;
    }

    .university-content strong {
      color: var(--green-800);
      font-size: .96rem;
      line-height: 1.5;
    }

    .university-content small {
      margin-top: .55rem;
      color: var(--muted);
      font-size: .82rem;
      line-height: 1.5;
    }

    .university-content p {
      margin: auto 0 0;
      padding-top: 1.8rem;
      color: var(--muted);
      font-size: .9rem;
      line-height: 1.65;
    }

    .university-featured {
      background: var(--green-900);
      color: var(--white);
      border-color: var(--green-900);
    }

    .university-featured .university-content > span {
      color: var(--lime);
    }

    .university-featured .university-content strong {
      color: var(--lime);
    }

    .university-featured .university-content small,
    .university-featured .university-content p {
      color: rgba(251,252,247,.75);
    }


    /* SKILLS */

    .skills-section {
      background: var(--paper);
    }

    .skills-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1px;
      border: 1px solid var(--line);
      background: var(--line);
    }

    .skill-card {
      min-height: 300px;
      padding: 2.2rem;
      background: var(--paper-2);
    }

    .skill-drawing {
      width: 82px;
      height: 82px;
      margin-bottom: 1.8rem;
    }

    .skill-drawing svg {
      width: 100%;
      height: 100%;
    }

    .skill-card h3 {
      margin: 0 0 .9rem;
      font-size: 1.25rem;
      line-height: 1.2;
      letter-spacing: -.025em;
    }

    .skill-card p {
      margin: 0;
      max-width: 360px;
      color: var(--muted);
      font-size: .93rem;
      line-height: 1.7;
    }


    /* RESEARCH */

    .research-section {
      padding: 8rem 0;
      background: var(--green-900);
      color: var(--white);
    }

    .research-grid {
      display: grid;
      grid-template-columns: .85fr 1.15fr;
      gap: 7rem;
      align-items: start;
    }

    .research-kicker {
      color: var(--lime);
    }

    .research-grid h2 {
      max-width: 600px;
      margin: 0;
      font-size: clamp(2.5rem, 4vw, 4.2rem);
      line-height: 1.05;
      letter-spacing: -.05em;
    }

    .research-copy {
      max-width: 700px;
      font-size: 1.08rem;
      line-height: 1.8;
      color: rgba(251,252,247,.8);
    }

    .research-copy p {
      margin: 0 0 1.8rem;
    }


    /* RESPONSIVE */

    @media (max-width: 1050px) {

      .about-hero-grid {
        grid-template-columns: 1fr;
        gap: 4rem;
      }

      .about-photo-frame {
        justify-content: flex-start;
      }

      .university-grid {
        grid-template-columns: 1fr;
      }

      .skills-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .research-grid {
        grid-template-columns: 1fr;
        gap: 3rem;
      }
    }


    @media (max-width: 700px) {

      .about-shell {
        width: calc(100% - 2.5rem);
      }

      .about-hero {
        padding: 4.5rem 0 5rem;
      }

      .about-hero-copy h1 {
        font-size: 2.8rem;
      }

      .about-photo-frame img {
        width: 240px;
      }

      .about-section {
        padding: 5rem 0;
      }

      .university-card {
        grid-template-columns: 1fr;
      }

      .university-image svg {
        min-height: 220px;
      }

      .university-image img {
        width: 160px;
        height: 90px;
      }

      .skills-grid {
        grid-template-columns: 1fr;
      }

      .research-section {
        padding: 5rem 0;
      }
    }

  </style>

</BaseLayout>

```
