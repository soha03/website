---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="About Me | Soha Sami"
  description="About Soha Sami, her academic background, skills and research interests across economics, finance, energy markets and climate risk."
  active="about"
>

  <main class="about-page">

    <!-- HERO -->
    <section class="about-hero">
      <div class="about-hero-inner">

        <p class="eyebrow">ABOUT ME</p>

        <h1>
          I study how uncertainty and the energy transition
          shape markets, financial decisions and risk.
        </h1>

        <p class="about-intro">
          My background is in economics and mathematics, with studies across
          finance, energy economics, quantitative finance, computational
          methods and climate-related finance.
        </p>

        <div class="profile-photo">
          <img
            src="/website/images/soha-profile.png"
            alt="Soha Sami"
          />
        </div>

      </div>
    </section>


    <!-- ACADEMIC PATH -->
    <section class="about-section academic-section">

      <div class="section-heading">
        <p class="eyebrow">ACADEMIC PATH</p>
        <h2>Economics, finance, energy and quantitative methods.</h2>
      </div>

      <div class="academic-grid">

        <!-- DELHI -->
        <a
          class="academic-card"
          href="https://www.du.ac.in/"
          target="_blank"
          rel="noreferrer"
        >
          <div class="card-location">NEW DELHI · INDIA ↗</div>

          <h3>University of Delhi</h3>

          <p class="degree">
            BA Economics &amp; Mathematics
          </p>

          <p class="card-meta">
            2021–2025
          </p>

          <p class="card-description">
            Economics, mathematics, statistics and quantitative analysis,
            providing the foundation for my graduate studies.
          </p>
        </a>


        <!-- BOLOGNA -->
        <a
          class="academic-card"
          href="https://www.unibo.it/en/study/second-cycle-degree/programme/2026/6693"
          target="_blank"
          rel="noreferrer"
        >
          <div class="card-location">BOLOGNA · ITALY ↗</div>

          <h3>Università di Bologna</h3>

          <p class="degree">
            MSc Greening Energy Market and Finance
          </p>

          <p class="card-meta">
            Finance · Economics · Energy &amp; Climate
          </p>

          <p class="card-description">
            Finance and economics applied to energy and climate, including
            financial markets, climate and energy economics, risk modelling,
            asset management and transition risk.
          </p>
        </a>


        <!-- LMU -->
        <a
          class="academic-card"
          href="https://www.fm.math.lmu.de/en/study-programs/master-financial-and-insurance-mathematics/"
          target="_blank"
          rel="noreferrer"
        >
          <div class="card-location">MUNICH · GERMANY ↗</div>

          <h3>LMU Munich</h3>

          <p class="degree">
            MSc Financial and Insurance Mathematics
          </p>

          <p class="card-meta">
            Computational Finance · Fixed Income · QRM · Numerical Methods
          </p>

          <p class="card-description">
            Financial mathematics and quantitative methods, with coursework
            in computational finance, fixed income, quantitative risk
            management and numerical methods.
          </p>
        </a>


        <!-- DAUPHINE -->
        <a
          class="academic-card academic-card-featured"
          href="https://dauphine.psl.eu/formations/masters/economie-finance"
          target="_blank"
          rel="noreferrer"
        >
          <div class="card-location">PARIS · FRANCE ↗</div>

          <h3>Université Paris Dauphine-PSL</h3>

          <p class="degree">
            MSc Economics and Finance
          </p>

          <p class="card-meta">
            Energy Economics · Empirical Markets · Project Finance
          </p>

          <p class="card-description">
            Economics and finance with a focus on energy and environmental
            economics, empirical modelling of electricity and gas markets,
            project finance and climate-related finance.
          </p>
        </a>

      </div>
    </section>


    <!-- SKILLS & METHODS -->
    <section class="about-section skills-section">

      <div class="section-heading">
        <p class="eyebrow">SKILLS &amp; METHODS</p>
        <h2>What I work with.</h2>
      </div>

      <div class="skills-grid">

        <article class="skill-group">
          <h3>Energy Markets</h3>
          <p>
            Electricity markets · Gas markets · Market design · Power prices ·
            Renewable generation · Flexibility
          </p>
        </article>

        <article class="skill-group">
          <h3>Finance &amp; Investment</h3>
          <p>
            Financial markets · Project finance · Asset management ·
            Fixed income · Green finance
          </p>
        </article>

        <article class="skill-group">
          <h3>Quantitative Finance</h3>
          <p>
            Stochastic modelling · Quantitative risk management ·
            Computational finance · Numerical methods
          </p>
        </article>

        <article class="skill-group">
          <h3>Economics &amp; Empirical Analysis</h3>
          <p>
            Energy economics · Econometrics · Empirical modelling ·
            Market analysis · Statistics
          </p>
        </article>

        <article class="skill-group">
          <h3>Climate &amp; Risk</h3>
          <p>
            Climate risk · Transition risk · Physical risk ·
            Climate economics · Risk assessment
          </p>
        </article>

        <article class="skill-group">
          <h3>Programming &amp; Research</h3>
          <p>
            Python · Java · Data analysis · Computational modelling ·
            Research methods · LaTeX
          </p>
        </article>

      </div>
    </section>


    <!-- RESEARCH FOCUS -->
    <section class="about-section research-section">

      <div class="section-heading">
        <p class="eyebrow">RESEARCH FOCUS</p>
        <h2>Questions around markets, finance and uncertainty.</h2>
      </div>

      <div class="research-grid">

        <article class="research-card">
          <h3>Energy systems &amp; markets</h3>
          <p>
            Electricity and gas markets, market design, renewable generation,
            flexibility and price formation.
          </p>
        </article>

        <article class="research-card">
          <h3>Finance &amp; risk</h3>
          <p>
            Financial markets, project finance, fixed income, quantitative
            risk and climate-related financial risk.
          </p>
        </article>

        <article class="research-card">
          <h3>Quantitative &amp; empirical modelling</h3>
          <p>
            Stochastic methods, econometrics, empirical market modelling,
            numerical methods and computational approaches to uncertainty.
          </p>
        </article>

      </div>
    </section>

  </main>


  <style>
    .about-page {
      background: var(--paper);
      color: var(--ink);
    }

    .about-hero {
      padding: 7rem 2rem 6rem;
      text-align: center;
    }

    .about-hero-inner {
      max-width: 980px;
      margin: 0 auto;
    }

    .about-hero .eyebrow {
      margin-bottom: 2rem;
    }

    .about-hero h1 {
      max-width: 900px;
      margin: 0 auto;
      font-size: clamp(2.8rem, 6vw, 5.5rem);
      line-height: 0.98;
      letter-spacing: -0.055em;
      font-weight: 600;
    }

    .about-intro {
      max-width: 720px;
      margin: 2.2rem auto 0;
      font-size: 1.2rem;
      line-height: 1.7;
      color: var(--muted);
    }

    .profile-photo {
      width: 240px;
      height: 240px;
      margin: 3.5rem auto 0;
      border-radius: 50%;
      padding: 7px;
      border: 2px solid var(--green-800);
      background: var(--paper);
      box-shadow: 0 18px 45px rgba(6, 37, 27, 0.12);
    }

    .profile-photo img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
      border-radius: 50%;
    }

    .about-section {
      max-width: 1400px;
      margin: 0 auto;
      padding: 6rem 2rem;
    }

    .section-heading {
      max-width: 760px;
      margin-bottom: 3rem;
    }

    .section-heading .eyebrow {
      margin-bottom: 1rem;
    }

    .section-heading h2 {
      margin: 0;
      font-size: clamp(2rem, 3.5vw, 3.4rem);
      line-height: 1.05;
      letter-spacing: -0.04em;
    }

    .academic-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.25rem;
    }

    .academic-card {
      display: flex;
      flex-direction: column;
      min-height: 390px;
      padding: 2rem;
      border: 1px solid var(--line);
      border-radius: 24px;
      background: var(--white);
      color: var(--ink);
      text-decoration: none;
      transition:
        transform 180ms ease,
        border-color 180ms ease,
        box-shadow 180ms ease;
    }

    .academic-card:hover {
      transform: translateY(-5px);
      border-color: var(--green-600);
      box-shadow: 0 18px 45px rgba(6, 37, 27, 0.08);
    }

    .academic-card-featured {
      background: var(--green-900);
      color: var(--white);
      border-color: var(--green-900);
    }

    .academic-card-featured:hover {
      border-color: var(--green-900);
    }

    .card-location {
      margin-bottom: 2.5rem;
      font-size: 0.76rem;
      line-height: 1.3;
      letter-spacing: 0.16em;
      font-weight: 600;
      color: var(--green-800);
    }

    .academic-card-featured .card-location {
      color: var(--lime);
    }

    .academic-card h3 {
      margin: 0 0 1rem;
      font-size: 1.45rem;
      line-height: 1.15;
      letter-spacing: -0.025em;
    }

    .degree {
      margin: 0;
      color: var(--green-800);
      font-size: 1rem;
      line-height: 1.5;
      font-weight: 600;
    }

    .academic-card-featured .degree {
      color: var(--lime);
    }

    .card-meta {
      margin: 0.8rem 0 0;
      font-size: 0.9rem;
      line-height: 1.5;
      color: var(--muted);
    }

    .academic-card-featured .card-meta {
      color: rgba(251, 252, 247, 0.72);
    }

    .card-description {
      margin: auto 0 0;
      padding-top: 2rem;
      font-size: 0.98rem;
      line-height: 1.7;
      color: var(--muted);
    }

    .academic-card-featured .card-description {
      color: rgba(251, 252, 247, 0.82);
    }

    .skills-section {
      border-top: 1px solid var(--line);
    }

    .skills-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1px;
      background: var(--line);
      border: 1px solid var(--line);
    }

    .skill-group {
      min-height: 210px;
      padding: 2rem;
      background: var(--paper-2);
    }

    .skill-group h3 {
      margin: 0 0 1.1rem;
      font-size: 1.25rem;
      line-height: 1.2;
      letter-spacing: -0.025em;
    }

    .skill-group p {
      margin: 0;
      font-size: 1rem;
      line-height: 1.75;
      color: var(--muted);
    }

    .research-section {
      border-top: 1px solid var(--line);
      padding-bottom: 8rem;
    }

    .research-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }

    .research-card {
      padding: 2.2rem;
      min-height: 260px;
      border-radius: 24px;
      background: var(--green-900);
      color: var(--white);
    }

    .research-card h3 {
      margin: 0 0 1.5rem;
      font-size: 1.35rem;
      line-height: 1.2;
      letter-spacing: -0.025em;
    }

    .research-card p {
      margin: 0;
      font-size: 1rem;
      line-height: 1.75;
      color: rgba(251, 252, 247, 0.8);
    }

    @media (max-width: 1100px) {
      .academic-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .skills-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .research-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 700px) {
      .about-hero {
        padding: 5rem 1.25rem 4rem;
      }

      .about-section {
        padding: 4rem 1.25rem;
      }

      .about-hero h1 {
        font-size: 2.7rem;
      }

      .about-intro {
        font-size: 1.05rem;
      }

      .profile-photo {
        width: 190px;
        height: 190px;
      }

      .academic-grid,
      .skills-grid {
        grid-template-columns: 1fr;
      }

      .academic-card {
        min-height: 340px;
      }
    }
  </style>

</BaseLayout>
