---
const projects = [
  {
    number: "01",
    title: "Stochastic Electricity Market Risk under Climate Transition Scenarios",
    description:
      "A Python research project studying European electricity prices, forecast accuracy and price-risk measures across bidding zones.",
    stack: "Python · NumPy · Pandas · Matplotlib · Statistical modelling",
    link: "https://github.com/soha03/climate-electricity-risk",
    label: "View source code",
  },
  {
    number: "02",
    title: "Quantitative Risk Modelling",
    description:
      "A developing collection of reproducible exercises and implementations covering financial risk, dependence modelling and quantitative methods.",
    stack: "Python · Probability · Risk measurement",
    link: "https://github.com/soha03",
    label: "Explore GitHub",
  },
  {
    number: "03",
    title: "Energy, Climate and ESG Data",
    description:
      "A planned research direction examining sustainability indicators and everyday energy-related decisions using publicly available data.",
    stack: "Data analysis · ESG metrics · Visualisation",
    link: "https://substack.com/@footnoteenergy",
    label: "Read related writing",
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Projects | Soha Sami</title>
    <meta name="description" content="Coding projects and quantitative analysis by Soha Sami." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet" />
    <style>
      :root{--paper:#f7f7f0;--green:#234b3b;--light:#e5ebdf;--ink:#202b25;--muted:#657169;--line:#dce1d7;--white:#fffefa}
      *{box-sizing:border-box}
      body{margin:0;background:var(--paper);color:var(--ink);font-family:"DM Sans",sans-serif;line-height:1.7}
      .wrap{width:min(1000px,calc(100% - 40px));margin:auto}
      header{padding:25px 0;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:20px;align-items:center}
      a{color:var(--green);text-decoration:none}
      .brand{font-weight:700;font-size:1.1rem}
      nav{display:flex;gap:20px;flex-wrap:wrap;font-size:.88rem}
      .hero{padding:80px 0 45px}
      .eyebrow{font-size:.75rem;font-weight:700;letter-spacing:.14em;color:var(--green);text-transform:uppercase}
      h1,h2{font-family:"Playfair Display",Georgia,serif;font-weight:500;line-height:1.2}
      h1{font-size:clamp(2.7rem,6vw,4.5rem);letter-spacing:-.04em;margin:15px 0}
      .lead{max-width:680px;color:var(--muted);font-size:1.05rem}
      .project{padding:32px 0;border-top:1px solid var(--line);display:grid;grid-template-columns:65px 1fr;gap:25px}
      .number{color:var(--green);font-size:.85rem;font-weight:700}
      h2{font-size:1.8rem;margin:0 0 12px}
      .description{max-width:700px;color:var(--muted)}
      .stack{font-size:.85rem;margin:18px 0}
      .link{font-size:.9rem;font-weight:700}
      footer{margin-top:50px;padding:25px 0;border-top:1px solid var(--line);font-size:.8rem;color:var(--muted)}
      @media(max-width:650px){header{align-items:flex-start;flex-direction:column}.project{grid-template-columns:35px 1fr;gap:12px}.hero{padding-top:55px}}
    </style>
  </head>
  <body>
    <div class="wrap">
      <header>
        <a class="brand" href="/">Soha Sami.</a>
        <nav aria-label="Main navigation">
          <a href="/">Home</a><a href="/research">Research</a><a href="/projects">Projects</a><a href="/articles">Articles</a><a href="/resources">Resources</a><a href="/about">About</a>
        </nav>
      </header>
      <main>
        <section class="hero">
          <div class="eyebrow">Code and applied analysis</div>
          <h1>Projects built around real questions.</h1>
          <p class="lead">A working portfolio of empirical research, quantitative methods and reproducible code. Projects are labelled according to their current stage so that plans are not mistaken for completed results.</p>
        </section>
        {projects.map((project) => (
          <article class="project">
            <div class="number">{project.number}</div>
            <div>
              <h2>{project.title}</h2>
              <p class="description">{project.description}</p>
              <p class="stack"><strong>Tools and methods:</strong> {project.stack}</p>
              <a class="link" href={project.link} target="_blank" rel="noreferrer">{project.label} ↗</a>
            </div>
          </article>
        ))}
      </main>
      <footer>© {new Date().getFullYear()} Soha Sami · <a href="/">Home</a></footer>
    </div>
  </body>
</html>
