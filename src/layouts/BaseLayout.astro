---
import "../styles/global.css";
interface Props { title?: string; description?: string }
const { title = "Soha Sami | Energy, Climate & Quantitative Research", description = "Research, computational projects and writing on energy markets, climate risk and quantitative finance." } = Astro.props;
---
<!doctype html>
<html lang="en">
<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>{title}</title><meta name="description" content={description} /><meta name="theme-color" content="#0b3b2b" /></head>
<body>
<div class="grain"></div>
<header class="site-header"><nav class="nav shell"><a class="brand" href="/website/">SS<span>.</span></a><div class="nav-links"><a href="/website/#research">Research</a><a href="/website/#projects">Projects</a><a href="/website/#writing">Writing</a><a href="/website/#about">About</a></div><a class="nav-contact" href="#contact">Contact <span>↗</span></a></nav></header>
<main><slot /></main>
<footer class="footer shell" id="contact"><div><p class="eyebrow">Open to research & industry opportunities</p><h2>Let’s build something<br /><em>useful.</em></h2></div><div class="footer-links"><a href="https://www.linkedin.com/in/sohasami/" target="_blank" rel="noreferrer">LinkedIn ↗</a><a href="https://substack.com/@footnoteenergy" target="_blank" rel="noreferrer">Substack ↗</a><a href="mailto:soha.sami@dauphine.eu">Email ↗</a></div><div class="footer-bottom"><span>Soha Sami</span><span>Energy · Climate · Quantitative Research</span><span>© {new Date().getFullYear()}</span></div></footer>
<script>const items=document.querySelectorAll('[data-reveal]');const observer=new IntersectionObserver((entries)=>entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('is-visible');observer.unobserve(e.target)}}),{threshold:.12});items.forEach(i=>observer.observe(i));</script>
</body></html>
