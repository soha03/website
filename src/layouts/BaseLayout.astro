---
const { title = "Soha Sami", description = "", active = "" } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
</head>
<body>
  <header class="site-header">
    <div class="shell nav">
      <a class="brand" href="/website/">SOHA SAMI<span>.</span></a>
      <nav class="nav-links" aria-label="Main navigation">
        <a href="/website/" class:list={{ active: active === "home" }}>Home</a>
        <a href="/website/research/" class:list={{ active: active === "research" }}>Research</a>
        <a href="/website/projects/" class:list={{ active: active === "projects" }}>Projects</a>
        <a href="/website/articles/" class:list={{ active: active === "articles" }}>Articles</a>
        <a href="/website/resources/" class:list={{ active: active === "resources" }}>Resources</a>
        <a href="/website/about/" class:list={{ active: active === "about" }}>About</a>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="footer shell" id="contact">
    <div class="footer-inner">
      <div>
        <p class="eyebrow">CONTACT</p>
        <h2>Soha Sami</h2>
        <p>Energy markets · Climate risk · Quantitative finance</p>
      </div>
      <div class="footer-links">
        <a href="mailto:soha.sami@dauphine.eu">Email</a>
        <a href="https://www.linkedin.com/in/sohasami/" target="_blank" rel="noreferrer">LinkedIn</a>
        <a href="https://substack.com/@footnoteenergy" target="_blank" rel="noreferrer">Substack</a>
        <a href="https://github.com/soha03" target="_blank" rel="noreferrer">GitHub</a>
      </div>
    </div>
  </footer>
</body>
</html>
